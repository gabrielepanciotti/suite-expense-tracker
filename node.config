{
  "schemaVersion": "2.0",
  "name": "ExpenseTracker",
  "slug": "expense-tracker",
  "taxonomyException": {"slug": "slug stabile, mai cambiato: nome host e riferimenti incrociati lo usano come id"},
  "type": "fastapi-app",
  "description": "Cattura le uscite e nient'altro: importa estratti conto (BBVA xlsx), storico Excel ed export PayPal, registra spese singole 'proposto' in attesa della banca (es. da Health), riconcilia scontrino<->riga di banca, propone la classificazione (merchant_map) e la fa confermare. Scrive tutto nel nodo finance via API; non tiene storico proprio, possiede solo merchant_map e il log degli import.",
  "domain": "personal/finance",
  "hostBase": "expense-tracker.example.com",
  "inherits": "../Life/node.config",
  "taxonomy": {
    "id": "expenseTracker",
    "cluster": [
      "Finance"
    ],
    "displayName": "ExpenseTracker",
    "commercial": false
  },
  "tooling": {},
  "capabilities": [
    "build",
    "test",
    "deploy"
  ],
  "agents": {
    "archetypes": []
  },
  "mcp": {
    "toolsets": []
  },
  "children": [],
  "deploy": {
    "backendPkg": "expense_tracker_backend",
    "appModule": "expense_tracker_backend.app:app",
    "migrations": true,
    "database": {
      "name": "expensetracker",
      "user": "expensetracker",
      "host": "expense-tracker-db",
      "driver": "postgresql+psycopg"
    }
  }
}
