# ExpenseTracker — copy to .env (gitignored). Values here are fictional.

# Compatible finance ledger API
FINANCE_URL=http://127.0.0.1:10023
FINANCE_TIMEOUT=15

# Own DB (merchant_map + imports). Unset = local SQLite in data/.
# DATABASE_URL=postgresql+psycopg://expensetracker:CHANGE_ME@localhost:11136/expensetracker

# Bank counterparty matching (";"-separated, device-local, never committed)
BANK_SELF_NAMES=
BANK_MEMBER_B_NAMES=

# Legacy workbook sheet-name overrides
LEGACY_SHARED_SHEET=
LEGACY_PERSONAL_SHEET=
# Optional password used by private Compose definitions. Set a real value only
# in your untracked .env file.
DB_PASSWORD=example-not-a-secret
DB_HOST_PORT=11136
